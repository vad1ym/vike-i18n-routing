{
  "name": "vike-i18n-routing",
  "version": "0.1.31",
  "description": "Vike plugin for i18n routing with locale prefixes and translated URLs",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "vike",
    "i18n",
    "routing",
    "react",
    "solid",
    "vue",
    "vite"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vad1ym/vike-i18n-routing.git"
  },
  "exports": {
    ".": "./lib/index.ts",
    "./core/useI18nRoute": "./lib/core/useI18nRoute.ts",
    "./config": "./lib/vike/+config.ts",
    "./__internal/onBeforeRoute": "./lib/vike/onBeforeRoute.ts",
    "./__internal/headersResponse": "./lib/vike/headersResponse.ts",
    "./middleware": "./lib/middleware.ts",
    "./vue/Link": "./lib/vue/Link.vue",
    "./react/Link": "./lib/react/Link.tsx",
    "./solid/Link": "./lib/solid/Link.tsx"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "test": "vitest run",
    "test:runtime": "vitest run tests/vike-runtime-*.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "changelog": "changelogen",
    "changelog:dry": "changelogen --no-output",
    "release": "changelogen --release",
    "example": "pnpm --filter example-vue dev",
    "example:build": "pnpm --filter example-vue build",
    "example:react": "pnpm --filter example-react dev",
    "example:react:build": "pnpm --filter example-react build",
    "example:solid": "pnpm --filter example-solid dev",
    "example:solid:build": "pnpm --filter example-solid build",
    "example:static": "pnpm --filter example-static dev",
    "example:static:build": "pnpm --filter example-static build",
    "example:static-dynamic": "pnpm --filter example-static-dynamic dev",
    "example:static-dynamic:build": "pnpm --filter example-static-dynamic build",
    "example:medicines": "pnpm --filter example-medicines dev",
    "example:medicines:build": "pnpm --filter example-medicines build",
    "example:perf": "pnpm --filter example-perf dev",
    "example:perf:build": "pnpm --filter example-perf build"
  },
  "changelog": {
    "output": false,
    "types": {
      "chore": false
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "changelogen": "^0.6.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "solid-js": "^1.9.14",
    "typescript": "^7.0.2",
    "vike": "^0.4.268",
    "vike-react": "^0.6.29",
    "vike-solid": "^0.8.7",
    "vike-vue": "^0.9.15",
    "vite": "^8.2.1",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10",
    "vue": "^3.5.41"
  },
  "peerDependencies": {
    "vike": ">=0.4.268"
  },
  "packageManager": "pnpm@10.11.0",
  "dependencies": {
    "path-to-regexp": "^8.4.2"
  }
}
