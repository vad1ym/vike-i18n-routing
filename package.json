{
  "name": "vike-i18n-routing",
  "version": "0.1.13",
  "description": "Vike plugin for i18n routing with locale prefixes and translated URLs",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "vike",
    "i18n",
    "routing",
    "react",
    "solid",
    "vue",
    "vite"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vad1ym/vike-i18n-routing.git"
  },
  "exports": {
    ".": "./lib/index.ts",
    "./react": "./lib/react/useI18nRoute.ts",
    "./solid": "./lib/solid/useI18nRoute.ts",
    "./vue": "./lib/vue/useI18nRoute.ts",
    "./config": "./lib/vike/+config.ts",
    "./__internal/onBeforeRoute": "./lib/vike/onBeforeRoute.ts",
    "./__internal/onBeforeRender": "./lib/vike/onBeforeRender.ts",
    "./__internal/onHydrationEnd": "./lib/vike/onHydrationEnd.ts",
    "./middleware": "./lib/middleware.ts"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "changelog": "changelogen",
    "changelog:dry": "changelogen --no-output",
    "release": "changelogen --release",
    "example": "pnpm --filter example-vue dev",
    "example:build": "pnpm --filter example-vue build",
    "example:react": "pnpm --filter example-react dev",
    "example:react:build": "pnpm --filter example-react build",
    "example:solid": "pnpm --filter example-solid dev",
    "example:solid:build": "pnpm --filter example-solid build",
    "example:static": "pnpm --filter example-static dev",
    "example:static:build": "pnpm --filter example-static build"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "changelogen": "^0.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "solid-js": "^1.9.9",
    "typescript": "^6.0.3",
    "vike": "^0.4.259",
    "vite": "^8.0.12",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.6",
    "vue": "^3.5.34"
  },
  "peerDependencies": {
    "vike": ">=0.4.259"
  },
  "packageManager": "pnpm@10.11.0",
  "dependencies": {
    "path-to-regexp": "^8.4.2"
  }
}
